{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/app.ts",
    "src/server.ts",
    "src/config/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/index.ts",
    "src/routes/auth.routes.ts",
    "src/routes/form.routes.ts",
    "src/routes/quotation.routes.ts",
    "src/routes/site.routes.ts",
    "src/controllers/auth.controller.ts",
    "src/controllers/form.controller.ts",
    "src/controllers/quotation.controller.ts",
    "src/controllers/site.controller.ts",
    "src/services/auth.service.ts",
    "src/services/form.service.ts",
    "src/services/health.service.ts",
    "src/services/quotation.service.ts",
    "src/services/site.service.ts",
    "src/repositories/auth.repository.ts",
    "src/repositories/form.repository.ts",
    "src/repositories/quotation.repository.ts",
    "src/repositories/site.repository.ts",
    "src/prisma/seed.ts",
    "src/utils/**/*.ts",
    "src/validators/auth.validator.ts",
    "src/validators/form.validator.ts",
    "src/validators/quotation.validator.ts",
    "src/types/**/*.d.ts",
    "src/docs/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
