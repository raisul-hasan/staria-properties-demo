generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminUserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CategoryType {
  PROPERTY
  PROJECT
  SERVICE
  BLOG
  DOWNLOAD
  GALLERY
}

enum MediaResourceType {
  IMAGE
  VIDEO
  PDF
  RAW
}

enum MediaUsageRole {
  PRIMARY
  THUMBNAIL
  GALLERY
  LOGO
  COVER
  DOCUMENT
  OG_IMAGE
  BACKGROUND
}

enum PageType {
  HOME
  ABOUT
  PROPERTIES
  PROJECTS
  CATEGORIES
  SERVICES
  GALLERY
  CERTIFICATES
  CLIENTS
  NEWS
  CAREER
  FACTORY
  CONTACT
  DOWNLOADS
  CUSTOM
}

enum PropertyListingType {
  SALE
  RENT
  LEASE
}

enum PropertyAvailability {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  UPCOMING
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum ProjectDevelopmentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  ON_HOLD
}

enum InquiryStatus {
  NEW
  ASSIGNED
  RESPONDED
  CLOSED
  SPAM
}

enum QuoteStatus {
  PENDING
  IN_REVIEW
  QUOTED
  REJECTED
  COMPLETED
}

enum QuoteConversationSenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum QuoteConversationType {
  MESSAGE
  INTERNAL_NOTE
  STATUS_CHANGE
  ASSIGNMENT
  EMAIL
}

enum CareerStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  SPAM
}

enum PostType {
  BLOG
  NEWS
}

enum AdminAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  AUTH_REFRESH
  SESSION_REVOKED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  EMAIL_VERIFICATION_REQUEST
  EMAIL_VERIFIED
  ACCOUNT_LOCKED
  QUOTATION_SUBMITTED
  QUOTATION_ASSIGNED
  QUOTATION_STATUS_CHANGED
  QUOTATION_MESSAGE_ADDED
  QUOTATION_EXPORTED
  CONTACT_SUBMITTED
  CONTACT_STATUS_CHANGED
  NEWSLETTER_SUBSCRIBED
  NEWSLETTER_STATUS_CHANGED
  ROLE_ASSIGNED
  ROLE_REVOKED
  PERMISSION_ASSIGNED
  PERMISSION_REVOKED
  STATUS_CHANGE
  PUBLISH
}

model AdminUser {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @db.VarChar(120)
  email               String          @unique @db.VarChar(160)
  passwordHash        String          @map("password_hash") @db.VarChar(255)
  status              AdminUserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?       @map("email_verified_at")
  passwordChangedAt   DateTime?       @map("password_changed_at")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  lastLoginAt         DateTime?       @map("last_login_at")
  isDemo              Boolean         @default(false) @map("is_demo")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")

  roles               AdminUserRole[]
  sessions            AdminSession[]
  passwordResetTokens AdminPasswordResetToken[]
  emailVerifyTokens   AdminEmailVerificationToken[]
  uploadedMedia       MediaAsset[]                  @relation("MediaUploadedBy")
  authoredPosts       BlogPost[]                    @relation("BlogAuthor")
  assignedMessages    ContactMessage[]              @relation("ContactAssignedTo")
  assignedQuotes      QuotationRequest[]            @relation("QuoteAssignedTo")
  quoteConversations  QuotationConversation[]       @relation("QuoteConversationAuthor")
  updatedSettings     WebsiteSetting[]              @relation("SettingUpdatedBy")
  auditLogs           AuditLog[]                    @relation("AuditActor")
  newsletterCampaigns NewsletterCampaign[]          @relation("CampaignCreatedBy")

  @@index([status, deletedAt])
  @@index([lockedUntil])
  @@index([createdAt])
  @@map("admin_users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(80)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       AdminUserRole[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminSession {
  id                  String    @id @default(uuid()) @db.Uuid
  adminUserId         String    @map("admin_user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash") @db.VarChar(255)
  tokenFamily         String    @map("token_family") @db.Uuid
  ipAddress           String?   @map("ip_address") @db.VarChar(64)
  userAgent           String?   @map("user_agent") @db.Text
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  replacedBy    AdminSession?  @relation("AdminSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacementOf AdminSession[] @relation("AdminSessionRotation")

  @@index([adminUserId, revokedAt, expiresAt])
  @@index([tokenFamily])
  @@index([replacedBySessionId])
  @@map("admin_sessions")
}

model AdminPasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.Text
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt, expiresAt])
  @@map("admin_password_reset_tokens")
}

model AdminEmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.Text
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, usedAt, expiresAt])
  @@map("admin_email_verification_tokens")
}

model MediaAsset {
  id                 String            @id @default(uuid()) @db.Uuid
  cloudinaryPublicId String            @unique @map("cloudinary_public_id") @db.VarChar(255)
  secureUrl          String            @map("secure_url") @db.Text
  resourceType       MediaResourceType @map("resource_type")
  format             String?           @db.VarChar(30)
  bytes              Int?
  width              Int?
  height             Int?
  folder             String?           @db.VarChar(160)
  altText            String?           @map("alt_text") @db.VarChar(255)
  caption            String?           @db.Text
  uploadedById       String?           @map("uploaded_by_id") @db.Uuid
  isDemo             Boolean           @default(false) @map("is_demo")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")

  uploadedBy       AdminUser?         @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  seoMetadata      SeoMetadata[]      @relation("SeoOgImage")
  heroSlides       HeroSlide[]        @relation("HeroSlideMedia")
  websiteSettings  WebsiteSetting[]   @relation("SettingMedia")
  categoryMedia    CategoryMedia[]
  propertyMedia    PropertyMedia[]
  projectMedia     ProjectMedia[]
  serviceMedia     ServiceMedia[]
  galleryItems     GalleryItem[]
  certificateMedia CertificateMedia[]
  clientMedia      ClientMedia[]
  partnerMedia     PartnerMedia[]
  factoryMedia     FactoryMedia[]
  downloads        Download[]         @relation("DownloadFile")
  jobApplications  JobApplication[]   @relation("ApplicationResume")

  @@index([resourceType, deletedAt])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("media_assets")
}

model SeoMetadata {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(180)
  description    String?       @db.VarChar(320)
  keywords       String?       @db.Text
  canonicalUrl   String?       @map("canonical_url") @db.Text
  robots         String?       @db.VarChar(80)
  ogTitle        String?       @map("og_title") @db.VarChar(180)
  ogDescription  String?       @map("og_description") @db.VarChar(320)
  ogImageId      String?       @map("og_image_id") @db.Uuid
  structuredData Json?         @map("structured_data")
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  pageId         String? @unique @map("page_id") @db.Uuid
  categoryId     String? @unique @map("category_id") @db.Uuid
  propertyId     String? @unique @map("property_id") @db.Uuid
  projectId      String? @unique @map("project_id") @db.Uuid
  serviceId      String? @unique @map("service_id") @db.Uuid
  galleryAlbumId String? @unique @map("gallery_album_id") @db.Uuid
  certificateId  String? @unique @map("certificate_id") @db.Uuid
  clientId       String? @unique @map("client_id") @db.Uuid
  blogPostId     String? @unique @map("blog_post_id") @db.Uuid
  jobPostingId   String? @unique @map("job_posting_id") @db.Uuid
  factoryId      String? @unique @map("factory_id") @db.Uuid
  downloadId     String? @unique @map("download_id") @db.Uuid

  ogImage      MediaAsset?   @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  page         Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  galleryAlbum GalleryAlbum? @relation(fields: [galleryAlbumId], references: [id], onDelete: Cascade)
  certificate  Certificate?  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blogPost     BlogPost?     @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting?   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  factory      Factory?      @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  download     Download?     @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@index([status, deletedAt])
  @@index([ogImageId])
  @@map("seo_metadata")
}

model Page {
  id          String        @id @default(uuid()) @db.Uuid
  pageType    PageType      @map("page_type")
  title       String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(180)
  status      ContentStatus @default(DRAFT)
  isDemo      Boolean       @default(false) @map("is_demo")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  sections   PageSection[]
  heroSlides HeroSlide[]
  seo        SeoMetadata?

  @@index([pageType, status])
  @@index([deletedAt])
  @@map("pages")
}

model PageSection {
  id         String        @id @default(uuid()) @db.Uuid
  pageId     String        @map("page_id") @db.Uuid
  sectionKey String        @map("section_key") @db.VarChar(100)
  title      String?       @db.VarChar(180)
  subtitle   String?       @db.VarChar(255)
  body       String?       @db.Text
  status     ContentStatus @default(DRAFT)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  page  Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items PageSectionItem[]

  @@unique([pageId, sectionKey])
  @@index([pageId, status, sortOrder])
  @@map("page_sections")
}

model PageSectionItem {
  id        String        @id @default(uuid()) @db.Uuid
  sectionId String        @map("section_id") @db.Uuid
  title     String?       @db.VarChar(180)
  subtitle  String?       @db.VarChar(255)
  body      String?       @db.Text
  linkLabel String?       @map("link_label") @db.VarChar(80)
  linkUrl   String?       @map("link_url") @db.Text
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, status, sortOrder])
  @@map("page_section_items")
}

model HeroSlide {
  id          String        @id @default(uuid()) @db.Uuid
  pageId      String?       @map("page_id") @db.Uuid
  mediaId     String        @map("media_id") @db.Uuid
  eyebrow     String?       @db.VarChar(120)
  title       String        @db.VarChar(180)
  subtitle    String?       @db.VarChar(320)
  ctaLabel    String?       @map("cta_label") @db.VarChar(80)
  ctaUrl      String?       @map("cta_url") @db.Text
  status      ContentStatus @default(DRAFT)
  isDemo      Boolean       @default(false) @map("is_demo")
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  page  Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media MediaAsset @relation("HeroSlideMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([pageId, status, sortOrder])
  @@index([mediaId])
  @@map("hero_slides")
}

model WebsiteSetting {
  id          String        @id @default(uuid()) @db.Uuid
  group       String        @db.VarChar(80)
  key         String        @unique @db.VarChar(120)
  value       Json?
  mediaId     String?       @map("media_id") @db.Uuid
  updatedById String?       @map("updated_by_id") @db.Uuid
  status      ContentStatus @default(PUBLISHED)
  isDemo      Boolean       @default(false) @map("is_demo")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  media     MediaAsset? @relation("SettingMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  updatedBy AdminUser?  @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group, status])
  @@index([mediaId])
  @@index([deletedAt])
  @@map("website_settings")
}

model CompanyStatistic {
  id        String       @id @default(uuid()) @db.Uuid
  label     String       @db.VarChar(120)
  value     Decimal      @db.Decimal(18, 2)
  prefix    String?      @db.VarChar(20)
  suffix    String?      @db.VarChar(20)
  note      String?      @db.VarChar(180)
  status    RecordStatus @default(ACTIVE)
  isDemo    Boolean      @default(false) @map("is_demo")
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@index([status, sortOrder])
  @@index([deletedAt])
  @@map("company_statistics")
}

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  parentId     String?      @map("parent_id") @db.Uuid
  categoryType CategoryType @map("category_type")
  name         String       @db.VarChar(140)
  slug         String       @db.VarChar(160)
  description  String?      @db.Text
  status       RecordStatus @default(ACTIVE)
  isDemo       Boolean      @default(false) @map("is_demo")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  parent         Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]             @relation("CategoryTree")
  media          CategoryMedia[]
  properties     PropertyCategory[]
  projects       Project[]
  services       Service[]
  blogPosts      BlogPost[]
  downloads      Download[]
  galleryAlbums  GalleryAlbum[]
  quotationItems QuotationRequestItem[]
  seo            SeoMetadata?

  @@unique([categoryType, slug])
  @@index([parentId])
  @@index([categoryType, status, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model CategoryMedia {
  categoryId String         @map("category_id") @db.Uuid
  mediaId    String         @map("media_id") @db.Uuid
  role       MediaUsageRole @default(COVER)
  sortOrder  Int            @default(0) @map("sort_order")

  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([categoryId, mediaId, role])
  @@index([mediaId])
  @@map("category_media")
}

model Property {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String?              @map("project_id") @db.Uuid
  addressId        String?              @unique @map("address_id") @db.Uuid
  referenceCode    String               @unique @map("reference_code") @db.VarChar(80)
  title            String               @db.VarChar(180)
  slug             String               @unique @db.VarChar(200)
  shortDescription String?              @map("short_description") @db.VarChar(500)
  description      String?              @db.Text
  listingType      PropertyListingType  @map("listing_type")
  availability     PropertyAvailability @default(AVAILABLE)
  price            Decimal?             @db.Decimal(16, 2)
  currency         String               @default("BDT") @db.VarChar(10)
  priceLabel       String?              @map("price_label") @db.VarChar(80)
  bedrooms         Int?
  bathrooms        Decimal?             @db.Decimal(4, 1)
  balconies        Int?
  parkingSpaces    Int?                 @map("parking_spaces")
  floorNumber      Int?                 @map("floor_number")
  totalFloors      Int?                 @map("total_floors")
  areaSqft         Decimal?             @map("area_sqft") @db.Decimal(12, 2)
  landAreaSqft     Decimal?             @map("land_area_sqft") @db.Decimal(12, 2)
  furnishing       FurnishingStatus?
  yearBuilt        Int?                 @map("year_built")
  availableFrom    DateTime?            @map("available_from")
  status           ContentStatus        @default(DRAFT)
  isFeatured       Boolean              @default(false) @map("is_featured")
  isDemo           Boolean              @default(false) @map("is_demo")
  sortOrder        Int                  @default(0) @map("sort_order")
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  project    Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  address    Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  categories PropertyCategory[]
  media      PropertyMedia[]
  amenities  PropertyAmenity[]
  quoteItems QuotationRequestItem[]
  seo        SeoMetadata?

  @@index([projectId])
  @@index([status, availability, isFeatured, sortOrder])
  @@index([listingType, price])
  @@index([bedrooms, bathrooms])
  @@index([isDemo])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("properties")
}

model PropertyCategory {
  propertyId String  @map("property_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([propertyId, categoryId])
  @@index([categoryId, isPrimary])
  @@map("property_categories")
}

model PropertyMedia {
  propertyId String         @map("property_id") @db.Uuid
  mediaId    String         @map("media_id") @db.Uuid
  role       MediaUsageRole @default(GALLERY)
  sortOrder  Int            @default(0) @map("sort_order")

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([propertyId, mediaId, role])
  @@index([mediaId])
  @@map("property_media")
}

model Project {
  id                 String                   @id @default(uuid()) @db.Uuid
  categoryId         String?                  @map("category_id") @db.Uuid
  addressId          String?                  @unique @map("address_id") @db.Uuid
  title              String                   @db.VarChar(180)
  slug               String                   @unique @db.VarChar(200)
  summary            String?                  @db.VarChar(600)
  description        String?                  @db.Text
  developmentStatus  ProjectDevelopmentStatus @default(UPCOMING) @map("development_status")
  completionPercent  Decimal?                 @map("completion_percent") @db.Decimal(5, 2)
  startDate          DateTime?                @map("start_date")
  expectedCompletion DateTime?                @map("expected_completion")
  completedAt        DateTime?                @map("completed_at")
  status             ContentStatus            @default(DRAFT)
  isFeatured         Boolean                  @default(false) @map("is_featured")
  isDemo             Boolean                  @default(false) @map("is_demo")
