  id                 String  @id @default(uuid()) @db.Uuid
  quotationRequestId String  @map("quotation_request_id") @db.Uuid
  propertyId         String? @map("property_id") @db.Uuid
  categoryId         String? @map("category_id") @db.Uuid
  unitId             String? @map("unit_id") @db.Uuid
  itemName           String  @map("item_name") @db.VarChar(180)
  description        String? @db.Text
  quantity           Decimal @db.Decimal(14, 2)
  sortOrder          Int     @default(0) @map("sort_order")

  quotationRequest QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit             MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([quotationRequestId, sortOrder])
  @@index([propertyId])
  @@index([categoryId])
  @@map("quotation_request_items")
}

model QuotationConversation {
  id                 String                      @id @default(uuid()) @db.Uuid
  quotationRequestId String                      @map("quotation_request_id") @db.Uuid
  adminUserId        String?                     @map("admin_user_id") @db.Uuid
  senderType         QuoteConversationSenderType @map("sender_type")
  conversationType   QuoteConversationType       @default(MESSAGE) @map("conversation_type")
  message            String                      @db.Text
  isInternal         Boolean                     @default(false) @map("is_internal")
  metadata           Json?
  createdAt          DateTime                    @default(now()) @map("created_at")

  quotationRequest QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  adminUser        AdminUser?       @relation("QuoteConversationAuthor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([quotationRequestId, createdAt])
  @@index([adminUserId])
  @@index([conversationType])
  @@map("quotation_conversations")
}

model NewsletterSubscriber {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(160)
  fullName        String?          @map("full_name") @db.VarChar(140)
  status          NewsletterStatus @default(SUBSCRIBED)
  source          String?          @db.VarChar(120)
  consentAccepted Boolean          @default(false) @map("consent_accepted")
  ipAddress       String?          @map("ip_address") @db.VarChar(64)
  userAgent       String?          @map("user_agent") @db.Text
  recaptchaScore  Decimal?         @map("recaptcha_score") @db.Decimal(5, 2)
  recaptchaAction String?          @map("recaptcha_action") @db.VarChar(80)
  spamScore       Int              @default(0) @map("spam_score")
  spamReason      String?          @map("spam_reason") @db.Text
  isDemo          Boolean          @default(false) @map("is_demo")
  subscribedAt    DateTime         @default(now()) @map("subscribed_at")
  unsubscribedAt  DateTime?        @map("unsubscribed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  campaigns NewsletterCampaignRecipient[]

  @@index([status])
  @@index([spamScore])
  @@index([deletedAt])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id          String        @id @default(uuid()) @db.Uuid
  createdById String?       @map("created_by_id") @db.Uuid
  subject     String        @db.VarChar(180)
  body        String        @db.Text
  status      ContentStatus @default(DRAFT)
  scheduledAt DateTime?     @map("scheduled_at")
  sentAt      DateTime?     @map("sent_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  createdBy  AdminUser?                    @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients NewsletterCampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("newsletter_campaigns")
}

model NewsletterCampaignRecipient {
  campaignId   String    @map("campaign_id") @db.Uuid
  subscriberId String    @map("subscriber_id") @db.Uuid
  sentAt       DateTime? @map("sent_at")
  openedAt     DateTime? @map("opened_at")
  clickedAt    DateTime? @map("clicked_at")

  campaign   NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([campaignId, subscriberId])
  @@index([subscriberId])
  @@map("newsletter_campaign_recipients")
}

model Download {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  fileMediaId String        @map("file_media_id") @db.Uuid
  title       String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(200)
  description String?       @db.Text
  status      ContentStatus @default(DRAFT)
  isDemo      Boolean       @default(false) @map("is_demo")
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category  Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fileMedia MediaAsset   @relation("DownloadFile", fields: [fileMediaId], references: [id], onDelete: Restrict)
  seo       SeoMetadata?

  @@index([categoryId])
  @@index([status, sortOrder])
  @@index([fileMediaId])
  @@index([deletedAt])
  @@map("downloads")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AdminAction
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String?     @map("entity_id") @db.Uuid
  beforeData Json?       @map("before_data")
  afterData  Json?       @map("after_data")
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(255)
  createdAt  DateTime    @default(now()) @map("created_at")

  actor AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
