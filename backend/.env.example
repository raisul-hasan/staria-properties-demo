NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staria_properties?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_NAME=staria_access_token
REFRESH_TOKEN_COOKIE_NAME=staria_refresh_token
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000
JWT_COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5173/admin
ENABLE_REGISTRATION=true
LOGIN_FAILURE_LIMIT=5
ACCOUNT_LOCK_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
MAX_ACTIVE_SESSIONS=10

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
FORM_RATE_LIMIT_WINDOW_MS=900000
FORM_RATE_LIMIT_MAX=10
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_REQUIRED=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=staria-properties

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Staria Properties <no-reply@staria.com.bd>"
ADMIN_EMAILS=info@staria.com.bd

LOG_LEVEL=info
SEED_ADMIN_NAME=Staria Demo Owner
SEED_ADMIN_EMAIL=owner@staria.demo
SEED_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
SEED_REVIEWER_NAME=Shareholder Reviewer
SEED_REVIEWER_EMAIL=reviewer@staria.demo
SEED_REVIEWER_PASSWORD=replace-with-a-different-12-character-or-longer-password
